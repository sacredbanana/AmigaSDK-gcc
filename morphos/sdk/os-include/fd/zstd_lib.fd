##base _ZSTDBase
##bias 30
##public
* Version API
ZSTD_versionNumber()(sysv)
ZSTD_versionString()(sysv)
* Simple CORE API
ZSTD_compress(dst,dstCapacity,src,srcSize,compressionLevel)(sysv)
ZSTD_decompress(dst,dstCapacity,src,compressedSize)(sysv)
* Decompression helper functions
ZSTD_getFrameContentSize(src,srcSize)(sysv)
ZSTD_getDecompressedSize(src,srcSize)(sysv)
ZSTD_findFrameCompressedSize(src,srcSize)(sysv)
* Compression helper functions
ZSTD_compressBound(srcSize)(sysv)
* Error helper functions
ZSTD_isError(result)(sysv)
ZSTD_getErrorCode(functionResult)(sysv)
ZSTD_getErrorName(result)(sysv)
ZSTD_minCLevel()(sysv)
ZSTD_maxCLevel()(sysv)
ZSTD_defaultCLevel()(sysv)
ZSTD_getErrorString(code)(sysv)
* Explicit context
ZSTD_createCCtx()(sysv)
ZSTD_freeCCtx(cctx)(sysv)
ZSTD_compressCCtx(cctx,dst,dstCapacity,src,srcSize,compressionLevel)(sysv)
ZSTD_createDCtx()(sysv)
ZSTD_freeDCtx(dctx)(sysv)
ZSTD_decompressDCtx(dctx,dst,dstCapacity,src,srcSize)(sysv)
* Advanced compression API
ZSTD_cParam_getBounds(cParam)(sysv)
ZSTD_CCtx_setParameter(cctx,param,value)(sysv)
ZSTD_CCtx_setPledgedSrcSize(cctx,pledgedSrcSize)(sysv)
ZSTD_CCtx_reset(cctx,reset)(sysv)
ZSTD_compress2(cctx,dst,dstCapacity,src,srcSize)(sysv)
* Advanced decompression API
ZSTD_dParam_getBounds(dParam)(sysv)
ZSTD_DCtx_setParameter(dctx,param,value)(sysv)
ZSTD_DCtx_reset(dctx,reset)(sysv)
* Streaming compression API
ZSTD_createCStream()(sysv)
ZSTD_freeCStream(zcs)(sysv)
ZSTD_compressStream2(cctx,output,input,endOp)(sysv)
ZSTD_CStreamInSize()(sysv)
ZSTD_CStreamOutSize()(sysv)
* Legacy streaming compression API
ZSTD_initCStream(zcs,compressionLevel)(sysv)
ZSTD_compressStream(zcs,output,input)(sysv)
ZSTD_flushStream(zcs,output)(sysv)
ZSTD_endStream(zcs,output)(sysv)
* Streaming decompression API
ZSTD_createDStream()(sysv)
ZSTD_freeDStream(zds)(sysv)
ZSTD_initDStream(zds)(sysv)
ZSTD_decompressStream(zds,output,input)(sysv)
ZSTD_DStreamInSize()(sysv)
ZSTD_DStreamOutSize()(sysv)
* Simple dictionary API
ZSTD_compress_usingDict(ctx,dst,dstCapacity,src,srcSize,dict,dictSize,compressionLevel)(sysv)
ZSTD_decompress_usingDict(dctx,dst,dstCapacity,src,srcSize,dict,dictSize)(sysv)
* Bulk processing dictionary API
ZSTD_createCDict(dictBuffer,dictSize,compressionLevel)(sysv)
ZSTD_freeCDict(CDict)(sysv)
ZSTD_compress_usingCDict(cctx,dst,dstCapacity,src,srcSize,cdict)(sysv)
ZSTD_createDDict(dictBuffer,dictSize)(sysv)
ZSTD_freeDDict(ddict)(sysv)
ZSTD_decompress_usingDDict(dctx,dst,dstCapacity,src,srcSize,ddict)(sysv)
* Dictionary helper functions
ZSTD_getDictID_fromDict(dict,dictSize)(sysv)
ZSTD_getDictID_fromCDict(cdict)(sysv)
ZSTD_getDictID_fromDDict(ddict)(sysv)
ZSTD_getDictID_fromFrame(src,srcSize)(sysv)
* Advanced dictionary and prefix API
ZSTD_CCtx_loadDictionary(cctx,dict,dictSize)(sysv)
ZSTD_CCtx_refCDict(cctx,cdict)(sysv)
ZSTD_CCtx_refPrefix(cctx,prefix,prefixSize)(sysv)
ZSTD_DCtx_loadDictionary(dctx,dict,dictSize)(sysv)
ZSTD_DCtx_refDDict(dctx,ddict)(sysv)
ZSTD_DCtx_refPrefix(dctx,prefix,prefixSize)(sysv)
* Memory management
ZSTD_sizeof_CCtx(cctx)(sysv)
ZSTD_sizeof_DCtx(dctx)(sysv)
ZSTD_sizeof_CStream(zcs)(sysv)
ZSTD_sizeof_DStream(zds)(sysv)
ZSTD_sizeof_CDict(cdict)(sysv)
ZSTD_sizeof_DDict(ddict)(sysv)
* Dictionary training API
ZDICT_trainFromBuffer(dictBuffer,dictBufferCapacity,samplesBuffer,samplesSizes,nbSamples)(sysv)
ZDICT_finalizeDictionary(dstDictBuffer,maxDictSize,dictContent,dictContentSize,samplesBuffer,samplesSizes,nbSamples,parameters)(sysv)
* Dictionary helper functions
ZDICT_getDictID(dictBuffer,dictSize)(sysv)
ZDICT_getDictHeaderSize(dictBuffer,dictSize)(sysv)
ZDICT_isError(errorCode)(sysv)
ZDICT_getErrorName(errorCode)(sysv)
* MorphOS special functions
zstdloader_entry(cmdline,cmdlinelen,wbstartupmsg,headersize)(base,sysv)
##end
