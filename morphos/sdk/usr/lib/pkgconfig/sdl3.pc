# sdl3 pkg-config file, sdl3 shared libraries for MorphOS

prefix=/gg/usr/local
exec_prefix=${prefix}
libdir=${exec_prefix}/lib
includedir=${prefix}/include

Name: sdl3
Description: Simple DirectMedia Layer (sdl3.library glue)
Version: 3.4.18
Requires: 
Libs: -L${libdir} -lSDL3 -lGL -noixemul -lm
Cflags: -I${includedir} -noixemul
