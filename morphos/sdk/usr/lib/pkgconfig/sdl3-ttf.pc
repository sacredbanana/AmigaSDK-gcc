# sdl3-ttf pkg-config file, sdl3 shared libraries for MorphOS

prefix=/gg/usr/local
exec_prefix=${prefix}
libdir=${exec_prefix}/lib
includedir=${prefix}/include

Name: sdl3-ttf
Description: TrueType font library for Simple DirectMedia Layer (sdl3_ttf.library glue)
Version: 3.3.0
Requires: sdl3 >= 3.4.0
Libs: -L${libdir} -lSDL3_ttf
Cflags: -I${includedir} -noixemul
