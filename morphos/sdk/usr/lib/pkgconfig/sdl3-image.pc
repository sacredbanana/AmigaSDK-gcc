# sdl3-image pkg-config file, sdl3 shared libraries for MorphOS

prefix=/gg/usr/local
exec_prefix=${prefix}
libdir=${exec_prefix}/lib
includedir=${prefix}/include

Name: sdl3-image
Description: image loading library for Simple DirectMedia Layer (sdl3_image.library glue)
Version: 3.4.9
Requires: sdl3 >= 3.4.0
Libs: -L${libdir} -lSDL3_image
Cflags: -I${includedir} -noixemul
