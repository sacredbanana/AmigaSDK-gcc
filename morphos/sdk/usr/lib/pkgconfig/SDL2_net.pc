prefix=/gg/usr/local
exec_prefix=${prefix}
libdir=${exec_prefix}/lib
includedir=${prefix}/include

Name: SDL2_net
Description: net library for Simple DirectMedia Layer
Version: 2.4.0
Requires: sdl2 >= 2.32.10
Libs: -L${libdir} -lSDL2_net
Requires.private: 
Libs.private: 
Cflags: -I${includedir}/SDL2