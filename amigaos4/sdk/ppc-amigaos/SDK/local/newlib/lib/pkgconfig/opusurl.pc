# opusurl installed pkg-config file

prefix=/SDK/local/newlib
exec_prefix=${prefix}
libdir=${exec_prefix}/lib
includedir=/SDK/local/common/include

Name: opusurl
Description: High-level Opus decoding library, URL support
Version: 0.12
Requires: opusfile
Requires.private: 
Conflicts:
Libs: -L${libdir} -lopusurl
