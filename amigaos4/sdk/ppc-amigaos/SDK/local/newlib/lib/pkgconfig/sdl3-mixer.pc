prefix=/SDK/local/newlib
exec_prefix=${prefix}
libdir=${prefix}/lib
includedir=/SDK/local/common/include

Name: SDL3_mixer
Description: mixer library for Simple DirectMedia Layer
Version: 3.2.4
Requires: sdl3 >= 3.4.0
Libs: -L${libdir} -lSDL3_mixer
Requires.private: opusfile vorbisfile libxmp
Libs.private: 
Cflags: -I${includedir}
