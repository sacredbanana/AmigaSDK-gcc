prefix=/SDK/local/newlib
exec_prefix=${prefix}
libdir=${exec_prefix}/lib
includedir=/SDK/local/common/include

Name: libwebp
Description: Library for the WebP graphics format
Version: 1.6.0
Requires.private: libsharpyuv
Cflags: -I${includedir}
Libs: -L${libdir} -lwebp -lsharpyuv -lpthread
Libs.private: -lm -lpthread 
