prefix=/SDK/local/newlib
exec_prefix=${prefix}
libdir=${prefix}/lib
includedir=/SDK/local/common/include

Name: harfbuzz raster
Description: HarfBuzz CPU rasterizer
Version: 14.2.1

Requires: harfbuzz = 14.2.1
Requires.private: 
Libs: -L${libdir} -lharfbuzz-raster
Libs.private: -lm 
Cflags: -I${includedir}/harfbuzz
