prefix=/SDK/local/newlib
exec_prefix=/SDK/local/newlib
libdir=/SDK/local/newlib/lib
includedir=/SDK/local/common/include

Name: FreeType 2
#URL: https://freetype.org
Description: A free, high-quality, and portable font engine.
Version: 26.6.20
Requires: 
Requires.private: zlib, libpng
Libs: -L/SDK/local/newlib/lib -lfreetype -lpng -lz
Libs.private: 
Cflags: -I${includedir}/freetype2
