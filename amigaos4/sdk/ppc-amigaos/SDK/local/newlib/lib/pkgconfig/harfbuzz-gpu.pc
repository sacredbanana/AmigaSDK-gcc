prefix=/SDK/local/newlib
exec_prefix=${prefix}
libdir=${prefix}/lib
includedir=/SDK/local/common/include

Name: harfbuzz gpu
Description: HarfBuzz GPU rasterization library
Version: 14.2.1

Requires: harfbuzz = 14.2.1
Requires.private: 
Libs: -L${libdir} -lharfbuzz-gpu
Libs.private: -lm 
Cflags: -I${includedir}/harfbuzz
