prefix=/SDK/local/newlib
exec_prefix=${prefix}
libdir=${prefix}/lib
includedir=/SDK/local/common/include

Name: SDL3_image
Description: image loading library for Simple DirectMedia Layer
Version: 3.4.4
Requires: sdl3 >= 3.4.0
Libs: -L${libdir} -lSDL3_image
Requires.private: libpng libtiff-4 libwebp libwebpdemux libwebpmux
Libs.private: 
Cflags: -I${includedir}
