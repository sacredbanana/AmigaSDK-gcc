# libvorbis pkg-config source file

prefix=/SDK/local/newlib
exec_prefix=/SDK/local/newlib
libdir=${exec_prefix}/lib
includedir=/SDK/local/common/include

Name: vorbis
Description: vorbis is the primary Ogg Vorbis library
Version: 1.3.7
Requires.private: ogg
Conflicts:
Libs: -L${libdir} -lvorbis 
Libs.private: -lm
Cflags: -I${includedir}
